<div class="category-view ">
  <div class="category-content">
    <div class="page-title-wrapper">
      <h1 class="page-title" id="page-title-heading" aria-labelledby="page-title-heading toolbar-amount">
        <span class="base" id="main-container-text" data-ui-id="page-title-wrapper"></span>
      </h1>
    </div>
    <div class="category-description">
      <style>
        #html-body [data-pb-style='DFGY5F3'] {
          justify-content: flex-start;
          display: flex;
          flex-direction: column;
          background-position: left top;
          background-size: cover;
          background-repeat: no-repeat;
          background-attachment: scroll;
        }
      </style>
      <div
        data-content-type="row"
        data-appearance="full-bleed"
        data-enable-parallax="0"
        data-parallax-speed="0.5"
        data-background-images="{}"
        data-background-type="image"
        data-video-loop="true"
        data-video-play-only-visible="true"
        data-video-lazy-load="true"
        data-video-fallback-src=""
        data-element="main"
        data-pb-style="DFGY5F3"
      >
        <div data-content-type="text" data-appearance="default" data-element="main">
          <p>
            Whether looking for deep hydration or lightweight replenishment, seal in your skincare benefits with our
            range of moisturisers.
          </p>
        </div>
      </div>
    </div>
  </div>
  <ul class="category-filter">
    <script>
      let categoryArray = [];
      var allCollections = JSON.parse('{{ collections | json }}');
      console.log({{collections.shop.metafields.custom.parent_category | json}});
      allCollections.forEach((element) => {
        categoryArray.push(element.handle);
      });
    </script>

    <li class="active">
      <a id="category-active" class="no-decoration" href="#"> </a>
    </li>
    <span id="peer-categories"></span>

    <script>
      categoryArray.forEach((element) => {
        let face = JSON.parse('{{collections.face.metafields.custom.subcategories.value | json}}');
        console.log(element);
      });

      let face = JSON.parse('{{collections.face.metafields.custom.subcategories.value | json}}');
      document.addEventListener('DOMContentLoaded', function () {
        const peerContainer = document.getElementById('peer-categories');
        const category = document.getElementById('category-active');
        const mainContainer = document.getElementById('main-container-text');
        if (face) {
          try {
            category.innerHTML = face[0].subcategory_details.category.replace('_', ' ');
            mainContainer.innerHTML = face[0].subcategory_details.category.replace('_', ' ').toUpperCase();
            let peerHtml = '';
            face.forEach((element) => {
              peerHtml += `<li class="un-active">
          <a class="no-decoration" href=${
            element.subcategory_details.link
          }>${element.subcategory_details.category.replace(/_/g, ' ')}</a>
        </li>`;
            });
            peerContainer.innerHTML = peerHtml;
          } catch (error) {
            console.error('Error parsing subcategories JSON:', error);
          }
        }
      });
    </script>
  </ul>
</div>
