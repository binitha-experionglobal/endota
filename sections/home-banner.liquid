{% if section.settings.show_content %}
  <div
    data-pb-style="U1HMF14"
    class="jarallax"
  >
    <ul>
      {% for link in linklists.collections.links %}
        <li>
          <a href="{{ link.url }}">{{ link.title }}</a>

          {% if link.links != blank %}
            <ul>
              {% for sub_link in link.links %}
                <li>
                  <a href="{{ sub_link.url }}">{{ sub_link.title }}</a>

                  {% if sub_link.links != blank %}
                    <ul>
                      {% for sub_sub_link in sub_link.links %}
                        <li>
                          <a href="{{ sub_sub_link.url }}">{{ sub_sub_link.title }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
    <div
      data-pb-style="ULY64YR"
    >
      <ul>
        {% for link in linklists['menu-handle'].links %}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {% endfor %}
      </ul>

      <div
        class="pagebuilder-column-line"
        data-pb-style="PU6PQCO"
      >
        <div
          class="pagebuilder-column"
          data-pb-style="J4HN5HH"
        ></div>
        <div
          class="pagebuilder-column comp-header-column"
          data-pb-style="ANXFJSH"
          style="
                    display: flex; align-items: center;
                    justify-content: center;
                    flex-direction: column;
                    position: relative;
            top: 300px;
          "
        >
          <div class="hero-banner-header" data-content-type="text" data-appearance="default" data-element="main">
            <h1>
              <span style="color: #ffffff;">{{ section.settings.text1 | default: 'You.First ' }}</span>
            </h1>
          </div>
          <div data-content-type="text" data-appearance="default" data-element="main">
            <p>
              <span style="font-size: 18pt; color: #ffffff;">
                {{- section.settings.text2 | default: 'prioritise you' -}}</span
              ><br>
              <span style="font-size: 18pt; color: #ffffff;">
                {{- section.settings.text3 | default: 'the world can wait' -}}
              </span>
            </p>
          </div>
          <div
            data-pb-style="DOVPWIG"
            class="winter-banner-button"
          >
            <div
              class="winter-banner-button"
              data-pb-style="FVT93GX"
            >
              <a
                class="pagebuilder-button-secondary"
                href="{{section.settings.urls| default:'https://endotaspa.com.au/'}}"
                data-pb-style="WEDKU7C"
                ><span data-element="link_text">{{- section.settings.link1 | default: 'Learn more' -}}</span></a
              >
            </div>
          </div>
        </div>
        <div
          class="pagebuilder-column"
          data-pb-style="KHYWX46"
        ></div>
      </div>
    </div>
    <div
      id="jarallax-container-0"
      style="position: absolute; top: 0px; left: 0px; width:100%; overflow: hidden; z-index: -100; height: 100%"
    >
      {% if section.settings.videourl %}
        <video
          id="background-video"
          autoplay
          muted
          playsinline
          loop
        >
          <source
            src="{% if section.settings.videourl %}{{ section.settings.videourl| video_tag }}{% else %}{{ 'banner.mp4' | asset_url }}{% endif %}"
            type="video/mp4"
          >
          Your browser does not support the video tag.
        </video>
      {% elsif section.settings.video_url %}
        {% if section.settings.video_url contains 'youtube.com' or section.settings.video_url contains 'youtu.be' %}
          <iframe
            id="background-video"
            src="{{ section.settings.video_url | replace: 'watch?v=', 'embed/' }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url | split: 'v=' | last }}"
            frameborder="0"
            allow="autoplay; encrypted-media"
            allowfullscreen
            style="position: absolute; top: 0px; left: 0px; width:100%; overflow: hidden; z-index: -100; height: 100%"
          ></iframe>

        {% elsif section.settings.video_url contains 'vimeo.com' %}
          <iframe
            id="background-video"
            src="https://player.vimeo.com/video/{{ section.settings.video_url | split: '/' | last }}?autoplay=1&muted=1&loop=1"
            frameborder="0"
            allow="autoplay; fullscreen"
            allowfullscreen
            style="position: absolute; top: 0px; left: 0px; width:100%; overflow: hidden; z-index: -100; height: 100%"
          ></iframe>

        {% elsif section.settings.video_url != blank %}
          <video id="background-video" autoplay muted playsinline loop>
            <source src="{{ section.settings.video_url }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {% endif %}
      {% else %}
        <img
          height=""
          width=""
          class="pagebuilder-mobile-hidden"
          src="{% if section.settings.imageurl %}{{ section.settings.imageurl | image_url }}{% else %}{{ 'banner1.png' | asset_url }}{% endif %}"
          alt=""
          title=""
          data-element="desktop_image"
          data-pb-style="H4XTM4I"
        >
      {% endif %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "video",
      "id": "videourl",
      "label": "Choose a Video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Choose a Video",
      "accept": ["vimeo", "youtube"]
    },
    {
      "type": "image_picker",
      "id": "imageurl",
      "label": "Choose an Image"
    },
    {
      "type": "text",
      "id": "text1",
      "label": "Text1"
    },
    {
      "type": "text",
      "id": "text2",
      "label": "Text2"
    },
    {
      "type": "text",
      "id": "text3",
      "label": "Text3"
    },
    {
      "type": "text",
      "id": "link1",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "urls",
      "label": "url for link text"
    }
  ],
  "presets": [
    {
      "name": "banner"
    }
  ]
}
{% endschema %}
