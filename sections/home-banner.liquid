{% if section.settings.show_content %}
  <div
    data-pb-style="U1HMF14"
    class="jarallax"
  >
    <div
      data-pb-style="ULY64YR"
    >
      <div
        class="pagebuilder-column-line"
        data-pb-style="PU6PQCO"
      >
        <div
          class="pagebuilder-column"
          data-pb-style="J4HN5HH"
        ></div>
        <div
          class="pagebuilder-column comp-header-column"
          data-pb-style="ANXFJSH"
          style="
                    display: flex; align-items: center;
                    justify-content: center;
                    flex-direction: column;
                    position: relative;
            top: 300px;
          "
        >
          <div class="hero-banner-header" data-content-type="text" data-appearance="default" data-element="main">
            <h1>
              <span style="color: #ffffff;">{{ section.settings.text1 | default: 'You.First ' }}</span>
            </h1>
          </div>
          <div data-content-type="text" data-appearance="default" data-element="main">
            <p>
              <span style="font-size: 18pt; color: #ffffff;">
                {{- section.settings.text2 | default: 'prioritise you' -}}</span
              ><br>
              <span style="font-size: 18pt; color: #ffffff;">
                {{- section.settings.text3 | default: 'the world can wait' -}}
              </span>
            </p>
          </div>
          <div
            data-pb-style="DOVPWIG"
            class="winter-banner-button"
          >
            <div
              class="winter-banner-button"
              data-pb-style="FVT93GX"
            >
              <a
                class="pagebuilder-button-secondary"
                href="{{section.settings.urls| default:'https://endotaspa.com.au/'}}"
                data-pb-style="WEDKU7C"
                ><span data-element="link_text">{{- section.settings.link1 | default: 'Learn more' -}}</span></a
              >
            </div>
          </div>
        </div>
        <div
          class="pagebuilder-column"
          data-pb-style="KHYWX46"
        ></div>
      </div>
    </div>
    <div
      id="jarallax-container-0"
      style="position: absolute; top: 0px; left: 0px; width:100%; overflow: hidden; z-index: -100; height: 100%"
    >
      {% if section.settings.videourl %}
        <video
          id="background-video"
          autoplay
          muted
          playsinline
          loop
        >
          <source
            src="{% if section.settings.videourl %}{{ section.settings.videourl| video_tag }}{% else %}{{ 'banner.mp4' | asset_url }}{% endif %}"
            type="video/mp4"
          >
          Your browser does not support the video tag.
        </video>
      {% else %}
        <img
          height=""
          width=""
          class="pagebuilder-mobile-hidden"
          src="{% if section.settings.imageurl %}{{ section.settings.imageurl | image_url }}{% else %}{{ 'banner1.png' | asset_url }}{% endif %}"
          alt=""
          title=""
          data-element="desktop_image"
          data-pb-style="H4XTM4I"
        >
      {% endif %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "video",
      "id": "videourl",
      "label": "Choose a Video"
    },
    {
      "type": "image_picker",
      "id": "imageurl",
      "label": "Choose an Image"
    },
    {
      "type": "text",
      "id": "text1",
      "label": "Text1"
    },
    {
      "type": "text",
      "id": "text2",
      "label": "Text2"
    },
    {
      "type": "text",
      "id": "text3",
      "label": "Text3"
    },
    {
      "type": "text",
      "id": "link1",
      "label": "Link text"
    },
    {
      "type": "url",
      "id": "urls",
      "label": "url for link text"
    }
  ],
  "presets": [
    {
      "name": "banner"
    }
  ]
}
{% endschema %}
