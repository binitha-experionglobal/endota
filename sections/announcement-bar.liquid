{% if section.settings.enable_announcement %}
  {% assign announcements = shop.metaobjects.announcement.values %}

  {% if announcements.size > 0 %}
    <div id="announcement-bar" style="position: fixed; top: 0; width: 100%; text-align: center; z-index: 1000;">
      <div id="announcement-slider">
        {% for announcement in announcements %}
          <div
            class="announcement-message"
            style="
              display: none;
              background-color: {{ announcement.background_color | default: '#008000' }};
              color: {{ announcement.text_color | default: '#ffffff' }};
              padding: 10px;
            "
          >
            {{ announcement.message }}
            {% if announcement.link != blank %}
              <a href="{{ announcement.link }}" style="color: inherit; text-decoration: underline;">Learn More</a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var messages = document.querySelectorAll('.announcement-message');
        if (messages.length > 0) {
          let index = 0;
          messages[index].style.display = 'block';

          setInterval(() => {
            messages[index].style.display = 'none';
            index = (index + 1) % messages.length;
            messages[index].style.display = 'block';
          }, 4000);
        }
      });
    </script>
  {% endif %}

  {% comment %}
    <div
      id="announcement-bar"
      style="
        background-color: {{ section.settings.announcement_bg }};
        color: {{ section.settings.announcement_text_color }};
        text-align: center;
        padding: 10px;
        position: fixed;
        width: 100%;
        top: 0;
        left: 0;
        z-index: 1000;
      "
    >
      <div id="announcement-slider">
        {% assign messages = section.settings.announcement_messages | split: '|' %}
        {% for message in messages %}
          <span class="announcement-message" style="display: none;">{{ message }}</span>
        {% endfor %}
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        var messages = document.querySelectorAll('.announcement-message');
        if (messages.length > 0) {
          let index = 0;
          messages[index].style.display = 'inline-block';

          setInterval(() => {
            messages[index].style.display = 'none';
            index = (index + 1) % messages.length;
            messages[index].style.display = 'inline-block';
          }, 4000);
        }
      });
    </script>
  {% endcomment %}
{% endif %}
{% schema %}
{
  "name": "banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Show this section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_announcement",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "textarea",
      "id": "announcement_messages",
      "label": "Announcement Messages (separate with `|`)",
      "default": "Free Shipping on orders over $75! | New Arrivals in stock!"
    },
    {
      "type": "color",
      "id": "announcement_bg",
      "label": "Background Color",
      "default": "#008000"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "announcement_link_text",
      "label": "Link Text (optional)"
    },
    {
      "type": "url",
      "id": "announcement_link_url",
      "label": "Link URL (optional)"
    }
  ],
  "presets": [
    {
      "name": "banner"
    }
  ]
}
{% endschema %}
